#!/usr/bin/env bash

set -euo pipefail # Exit on error, unset variables, and pipe failures

# === Project Root Detection ===
if [ -L "$0" ] ; then
    BIN_DIR=$(dirname "$(readlink -f "$0")") ;
else
    BIN_DIR=$(dirname "$0") ;
fi ;
PROJECT_ROOT=$(cd "${BIN_DIR}/.." && pwd)
CORE_DIR="${PROJECT_ROOT}/lib"
COMMANDS_DIR="${CORE_DIR}/commands"

# === Load Configuration ===
DEFAULT_CONFIG="${CORE_DIR}/utils/config.sh"
USER_CONFIG="${HOME}/.dockero/config"

# Source default configuration
if [[ -f "$DEFAULT_CONFIG" ]]; then
    # shellcheck disable=SC1090,SC1091
    source "$DEFAULT_CONFIG"
fi

# Override with user configuration if it exists
if [[ -f "$USER_CONFIG" ]]; then
    # shellcheck disable=SC1090
    source "$USER_CONFIG"
fi

# === Dependency Check ===
_check_dependencies() {
    local runtime="${DOCKERO_RUNTIME:-docker}"

    if ! command -v "$runtime" &>/dev/null; then
        echo "[ERROR] '$runtime' not found. Install Docker or set DOCKERO_RUNTIME." >&2
        exit 1
    fi
    if ! command -v jq &>/dev/null; then
        echo "[WARNING] jq not found. Some features (monitor health, etc.) will be limited." >&2
    fi
}
_check_dependencies
# Note: Sourced utilities config, colors, log, inipars, docker-helpers, and parameter-indexing
# are bundled/concatenated during the build process.

# === Parameter Indexing ===
parameter-indexing "$@" || exit 1 # Exit if parameter-indexing fails

# Initialize args array if not already done (defensive programming)
if [[ ${#args[@]} -eq 0 ]]; then
    # Fallback to original arguments if parameter-indexing didn't populate args
    for arg in "$@"; do
        if [[ ! "$arg" =~ ^- ]]; then
            args+=("$arg")
        fi
    done
fi

if [[ "${DOCKERO_DEBUG:-false}" == "true" ]]; then
    log.debug "Dockero Debug Mode Enabled"
    log.debug "Command: ${args[0]:-None}"
    log.debug "Global arguments: [${args[*]}]"
    log.debug "Parameters parsed: "
    for key in "${!params[@]}"; do
        log.debug "  - ${key} = ${params[$key]}"
    done
fi

# === Version Info ===
DOCKERO_VERSION="1.0.0"

# === Validation Functions ===
validate_container_name() {
    local name="$1"
    # Docker container names must match this regex: [a-zA-Z0-9][a-zA-Z0-9_.-]+
    # Regex breakdown:
    # ^[a-zA-Z0-9]    - Starts with an alphanumeric character
    # [a-zA-Z0-9_.-]* - Followed by zero or more alphanumeric characters, underscores, periods, or hyphens
    # $               - Ends of the string
    if [[ ! "$name" =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]*$ ]]; then
        log.error "Invalid container name: ${RED}$name${RESET_COLOR}"
        log.hint "Container names must start with alphanumeric and contain only [a-zA-Z0-9_.-]" >&2
        return 1
    fi
}

validate_image_name() {
    local name="$1"
    # Basic validation for image names
    # Regex breakdown:
    # ^[a-zA-Z0-9._-]+      - Starts with one or more alphanumeric, periods, underscores, or hyphens (registry/name part)
    # (/[a-zA-Z0-9._-]+)*   - Optional: zero or more repetitions of a slash followed by similar characters (more name parts)
    # (:[a-zA-Z0-9._-]+)?   - Optional: a tag part, starting with a colon followed by similar characters
    # $                     - End of the string
    if [[ ! "$name" =~ ^[a-zA-Z0-9._-]+(/[a-zA-Z0-9._-]+)*(:[a-zA-Z0-9._-]+)?$ ]]; then
        log.error "Invalid image name: ${RED}$name${RESET_COLOR}"
        log.hint "Image names should follow format: [registry/]name[:tag]" >&2
        return 1
    fi
}

# === Dynamic Command Loader ===
load_command() {
  local cmd_name_from_global_args="${args[0]}"

  # Validate cmd_name for path traversal and invalid characters
  if [[ ! "$cmd_name_from_global_args" =~ ^[a-zA-Z0-9_-]+$ ]]; then
    log.error "Invalid command name: '${BOLD_RED}$cmd_name_from_global_args${RESET_COLOR}'."
    exit 1
  fi

  # 1. Check user plugin directory first (~/.dockero/commands/)
  local user_cmd_file="${HOME}/.dockero/commands/${cmd_name_from_global_args}.sh"
  if [[ -f "$user_cmd_file" ]]; then
      # shellcheck disable=SC1090
      source "$user_cmd_file"
  fi

  local func_name="$cmd_name_from_global_args"

  # 2. Check if the function is already loaded (compiled built-in or loaded plugin)
  if declare -f "$func_name" >/dev/null 2>&1; then
      "$func_name" "${args[@]:1}"
      return 0
  fi

  log.error "Unknown command '${BOLD_RED}$cmd_name_from_global_args${RESET_COLOR}'."
  log.hint "Run '${BOLD_YELLOW}$0 -h${RESET_COLOR}' for usage."
  exit 1
}

# === Version Command Handler ===
show_version() {
  echo -e "${BOLD_CYAN}Dockero CLI${RESET_COLOR} ${BOLD_YELLOW}v$DOCKERO_VERSION${RESET_COLOR}"
  echo -e "Simplified Docker CLI with Autocompletion"
  echo -e "Runtime: ${BOLD_GREEN}${DOCKERO_RUNTIME:-docker}${RESET_COLOR}"
  echo -e "Default Port: ${BOLD_GREEN}${DOCKERO_DEFAULT_PORT:-80}${RESET_COLOR}"
}

# === Entrypoint ===

# Handle global flags first (--version, --help)
if [[ -z "${args[0]:-}" && ( -n "${params[v]+set}" || -n "${params[version]+set}" ) ]]; then
  show_version
  exit 0
elif [[ -n "${params[h]+set}"  || -n "${params[help]+set}" ]]; then
   # For 'dockero CMD -h', the command to explain is args[0].
   # For 'dockero -h', it's empty, so general help.
   explain "${args[0]:-}" "${args[@]:1}"
   exit 0
fi

# Handle 'version' as a subcommand
if [[ "${args[0]:-}" == 'version' ]]; then
  show_version
  exit 0
fi

# If no positional command is given after processing flags (e.g., just `dockero`)
if [[ -z "${args[0]:-}" ]]; then
    _show_general_help
    exit 0
fi

load_command "${args[0]}"