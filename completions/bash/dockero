#!/usr/bin/env bash

# Cache configuration
DOCKERO_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/dockero"
DOCKERO_CACHE_TTL=2  # Cache lifetime in seconds

# Ensure cache directory exists
mkdir -p "$DOCKERO_CACHE_DIR" 2>/dev/null

# Fast cache read with TTL check
_dockero_get_cache() {
  local cache_file="$DOCKERO_CACHE_DIR/$1"
  local ttl="${2:-$DOCKERO_CACHE_TTL}"
  local age
  
  if [[ -f "$cache_file" ]]; then
    age=$(( $(date +%s) - $(stat -c %Y "$cache_file" 2>/dev/null || stat -f %m "$cache_file" 2>/dev/null || echo 0) ))
    if (( age < ttl )); then
      cat "$cache_file"
      return 0
    fi
  fi
  return 1
}

# Async cache update (non-blocking)
_dockero_update_cache() {
  local cache_file="$DOCKERO_CACHE_DIR/$1"
  shift
  (
    "$@" > "${cache_file}.tmp" 2>/dev/null && mv "${cache_file}.tmp" "$cache_file"
  ) &
}

# Get all containers (cached)
_dockero_get_containers() {
  if ! _dockero_get_cache "containers"; then
    _dockero_update_cache "containers" ${DOCKERO_RUNTIME:-docker} ps -a --format "{{.Names}}"
  fi
}

# Get running containers only (cached)
_dockero_get_running() {
  if ! _dockero_get_cache "running"; then
    _dockero_update_cache "running" ${DOCKERO_RUNTIME:-docker} ps --filter "status=running" --format "{{.Names}}"
  fi
}

# Get stopped containers only (cached)
_dockero_get_stopped() {
  if ! _dockero_get_cache "stopped"; then
    _dockero_update_cache "stopped" ${DOCKERO_RUNTIME:-docker} ps --filter "status=exited" --format "{{.Names}}"
  fi
}

# Get local images (cached)
_dockero_get_images() {
  if ! _dockero_get_cache "images"; then
    _dockero_update_cache "images" ${DOCKERO_RUNTIME:-docker} images --format "{{.Repository}}:{{.Tag}}"
  fi
}

# Get tar files
_dockero_get_tars() {
  if ! _dockero_get_cache "tars" 5; then
    _dockero_update_cache "tars" bash -c 'printf "%s\n" *.tar 2>/dev/null | grep -v "^\*\.tar$"'
  fi
}

# Get all networks (cached)
_dockero_get_networks() {
  if ! _dockero_get_cache "networks"; then
    _dockero_update_cache "networks" ${DOCKERO_RUNTIME:-docker} network ls --format "{{.Name}}"
  fi
}

# Get all volumes (cached)
_dockero_get_volumes() {
  if ! _dockero_get_cache "volumes"; then
    _dockero_update_cache "volumes" ${DOCKERO_RUNTIME:-docker} volume ls --format "{{.Name}}"
  fi
}

_dockero_autocomplete() {
  local cur prev words cword
  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]}"
  prev="${COMP_WORDS[COMP_CWORD - 1]}"

  # Active base commands and aliases
  local base_cmds="run create start stop exec list ps ls remove rm rename inspect export import setup compose validate net volume registry dashboard monitor system heal plugin explain help version"
  local base_opts="--help -h --version -v"

  case $COMP_CWORD in
  1)
    # First argument - complete base commands
    # shellcheck disable=SC2207
    COMPREPLY=($(compgen -W "${base_cmds} ${base_opts}" -- "${cur}"))
    ;;
  2)
    # Second argument - context-specific completions
    case "$prev" in
    run|create)
      local images
      images=$(_dockero_get_images)
      # shellcheck disable=SC2207
      COMPREPLY=($(compgen -W "${images} -d -p -v -e --env-file --net --restart --no-volume" -- "${cur}"))
      ;;
    start)
      local stopped
      stopped=$(_dockero_get_stopped)
      # shellcheck disable=SC2207
      COMPREPLY=($(compgen -W "${stopped} -c" -- "${cur}"))
      ;;
    stop)
      local running
      running=$(_dockero_get_running)
      # shellcheck disable=SC2207
      COMPREPLY=($(compgen -W "${running} -t --timeout" -- "${cur}"))
      ;;
    exec)
      # For exec, don't complete command name; container comes at the end
      ;;
    remove|rm)
      local containers images
      containers=$(_dockero_get_containers)
      images=$(_dockero_get_images)
      # shellcheck disable=SC2207
      COMPREPLY=($(compgen -W "${containers} ${images}" -- "${cur}"))
      ;;
    rename)
      local containers
      containers=$(_dockero_get_containers)
      # shellcheck disable=SC2207
      COMPREPLY=($(compgen -W "${containers}" -- "${cur}"))
      ;;
    inspect)
      local containers images networks volumes
      containers=$(_dockero_get_containers)
      images=$(_dockero_get_images)
      networks=$(_dockero_get_networks)
      volumes=$(_dockero_get_volumes)
      # shellcheck disable=SC2207
      COMPREPLY=($(compgen -W "${containers} ${images} ${networks} ${volumes}" -- "${cur}"))
      ;;
    export)
      local containers
      containers=$(_dockero_get_containers)
      # shellcheck disable=SC2207
      COMPREPLY=($(compgen -W "${containers}" -- "${cur}"))
      ;;
    import)
      local tars
      tars=$(_dockero_get_tars)
      # shellcheck disable=SC2207
      COMPREPLY=($(compgen -W "${tars}" -- "${cur}"))
      ;;
    list|ps|ls)
      # shellcheck disable=SC2207
      COMPREPLY=($(compgen -W "img images" -- "${cur}"))
      ;;
    setup)
      # shellcheck disable=SC2207
      COMPREPLY=($(compgen -W "init run update teardown --preset --dry-run" -- "${cur}"))
      ;;
    compose)
      # shellcheck disable=SC2207
      COMPREPLY=($(compgen -W "up down start stop restart ps logs" -- "${cur}"))
      ;;
    validate)
      # shellcheck disable=SC2207
      COMPREPLY=($(compgen -f -- "${cur}"))
      ;;
    net)
      # shellcheck disable=SC2207
      COMPREPLY=($(compgen -W "new create delete add connect remove disconnect rename prune list inspect" -- "${cur}"))
      ;;
    volume)
      # shellcheck disable=SC2207
      COMPREPLY=($(compgen -W "list ls create remove rm inspect attach prune" -- "${cur}"))
      ;;
    registry)
      # shellcheck disable=SC2207
      COMPREPLY=($(compgen -W "login push pull list ls search logout" -- "${cur}"))
      ;;
    monitor)
      # shellcheck disable=SC2207
      COMPREPLY=($(compgen -W "top stats health logs watch" -- "${cur}"))
      ;;
    system)
      # shellcheck disable=SC2207
      COMPREPLY=($(compgen -W "service config info cleanup install dev" -- "${cur}"))
      ;;
    heal)
      # shellcheck disable=SC2207
      COMPREPLY=($(compgen -W "check fix auto diagnose cleanup restore watch" -- "${cur}"))
      ;;
    plugin)
      # shellcheck disable=SC2207
      COMPREPLY=($(compgen -W "list install remove delete" -- "${cur}"))
      ;;
    explain|help)
      # shellcheck disable=SC2207
      COMPREPLY=($(compgen -W "${base_cmds}" -- "${cur}"))
      ;;
    esac
    ;;
  3)
    # Third argument - nested subcommand completions
    case "${COMP_WORDS[1]}" in
    exec)
      local running
      running=$(_dockero_get_running)
      # shellcheck disable=SC2207
      COMPREPLY=($(compgen -W "${running}" -- "${cur}"))
      ;;
    setup)
      if [[ "$prev" == "init" ]]; then
        # shellcheck disable=SC2207
        COMPREPLY=($(compgen -W "--preset" -- "${cur}"))
      fi
      ;;
    system)
      case "$prev" in
      service)
        # shellcheck disable=SC2207
        COMPREPLY=($(compgen -W "create start stop enable disable status logs" -- "${cur}"))
        ;;
      config)
        # shellcheck disable=SC2207
        COMPREPLY=($(compgen -W "get set list reset" -- "${cur}"))
        ;;
      cleanup)
        # shellcheck disable=SC2207
        COMPREPLY=($(compgen -W "all containers images volumes builder system" -- "${cur}"))
        ;;
      esac
      ;;
    heal)
      case "$prev" in
      check)
        # shellcheck disable=SC2207
        COMPREPLY=($(compgen -W "system containers networks all" -- "${cur}"))
        ;;
      fix)
        # shellcheck disable=SC2207
        COMPREPLY=($(compgen -W "system containers images volumes networks all" -- "${cur}"))
        ;;
      diagnose)
        # shellcheck disable=SC2207
        COMPREPLY=($(compgen -W "startup network performance config storage permissions all" -- "${cur}"))
        ;;
      cleanup)
        # shellcheck disable=SC2207
        COMPREPLY=($(compgen -W "containers images volumes networks buildcache all" -- "${cur}"))
        ;;
      restore)
        # shellcheck disable=SC2207
        COMPREPLY=($(compgen -W "config workspace containers all" -- "${cur}"))
        ;;
      watch)
        # shellcheck disable=SC2207
        COMPREPLY=($(compgen -W "containers resources config all" -- "${cur}"))
        ;;
      esac
      ;;
    monitor)
      case "$prev" in
      top|stats|health|logs|watch)
        local running
        running=$(_dockero_get_running)
        # shellcheck disable=SC2207
        COMPREPLY=($(compgen -W "${running}" -- "${cur}"))
        ;;
      esac
      ;;
    net)
      case "$prev" in
      add|remove|connect|disconnect)
        local containers
        containers=$(_dockero_get_containers)
        # shellcheck disable=SC2207
        COMPREPLY=($(compgen -W "${containers}" -- "${cur}"))
        ;;
      delete|inspect|rename)
        local networks
        networks=$(_dockero_get_networks)
        # shellcheck disable=SC2207
        COMPREPLY=($(compgen -W "${networks}" -- "${cur}"))
        ;;
      esac
      ;;
    volume)
      case "$prev" in
      remove|rm|inspect)
        local volumes
        volumes=$(_dockero_get_volumes)
        # shellcheck disable=SC2207
        COMPREPLY=($(compgen -W "${volumes}" -- "${cur}"))
        ;;
      attach)
        local containers
        containers=$(_dockero_get_containers)
        # shellcheck disable=SC2207
        COMPREPLY=($(compgen -W "${containers}" -- "${cur}"))
        ;;
      esac
      ;;
    registry)
      case "$prev" in
      push|pull)
        local images
        images=$(_dockero_get_images)
        # shellcheck disable=SC2207
        COMPREPLY=($(compgen -W "${images}" -- "${cur}"))
        ;;
      esac
      ;;
    esac
    ;;
  4)
    case "${COMP_WORDS[1]}" in
    setup)
      if [[ "${COMP_WORDS[2]}" == "init" && "$prev" == "--preset" ]]; then
        # shellcheck disable=SC2207
        COMPREPLY=($(compgen -W "node python go rust php ruby java nginx redis postgres mysql" -- "${cur}"))
      fi
      ;;
    system)
      if [[ "${COMP_WORDS[2]}" == "service" ]]; then
        local containers
        containers=$(_dockero_get_containers)
        # shellcheck disable=SC2207
        COMPREPLY=($(compgen -W "${containers}" -- "${cur}"))
      fi
      ;;
    net)
      local subcmd="${COMP_WORDS[2]}"
      case "$subcmd" in
      add|remove|connect|disconnect|rename)
        local networks
        networks=$(_dockero_get_networks)
        # shellcheck disable=SC2207
        COMPREPLY=($(compgen -W "${networks}" -- "${cur}"))
        ;;
      esac
      ;;
    esac
    ;;
  *)
    # Position >= 4 for exec or other trailing targets
    if [[ "${COMP_WORDS[1]}" == "exec" ]]; then
      local running
      running=$(_dockero_get_running)
      # shellcheck disable=SC2207
      COMPREPLY=($(compgen -W "${running}" -- "${cur}"))
    fi
    ;;
  esac
}

# Cleanup old cache files on shell exit
_dockero_cleanup() {
  find "$DOCKERO_CACHE_DIR" -type f -mtime +1 -delete 2>/dev/null || true
}
trap _dockero_cleanup EXIT

complete -F _dockero_autocomplete dockero